# Wisdum environment configuration
# Copy to .env.local and fill in values. Never commit real credentials.
#
# The platform is pre-alpha: these variables document the intended
# configuration surface and will become effective as services land.

# --- Application ---
WISDUM_ENV=development
PORT=3001
# Address the API listens on. `npm run local` uses 127.0.0.1; containers need the default 0.0.0.0.
# HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000

# --- Web app (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Auth ---
# Signs bearer session tokens. At least 32 characters; generate one with `openssl rand -hex 32`.
# Required in production (the API refuses to start without it). In development, leaving it empty
# uses a random per-process secret, so sessions end whenever the API restarts.
JWT_SECRET=

# Who may create a tenant through POST /v1/onboarding/setup. The first tenant on a fresh
# instance can always be created; set true to let anyone sign up after that (hosted use).
WISDUM_ALLOW_SIGNUP=false

# Development only: creates dev@wisdum.local (password: wisdum-dev-password) on startup, and
# lets the web app show a "Quick Dev Sign In" button when NEXT_PUBLIC_WISDUM_DEV_SEED is also true.
# The API refuses to start with this enabled in production.
WISDUM_DEV_SEED=false
NEXT_PUBLIC_WISDUM_DEV_SEED=false

# --- PostgreSQL (primary datastore) ---
# Standard libpq connection string (used via the `pg` driver, no ORM).
DATABASE_URL=postgresql://wisdum:wisdum@localhost:5432/wisdum

# --- Redis (cache & task queues) ---
REDIS_URL=redis://localhost:6379/0

# --- Meilisearch (full-text search) ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# --- S3-compatible object storage (media & files) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=wisdum
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI providers. The first one set is used, in this order: Anthropic, OpenAI,
# Gemini, NVIDIA NIM, then a local Ollama. With none set the app runs in "demo mode": automatic
# reasoning and drafts are canned sample text, and "Create content from this
# source" is disabled. REASONING_LLM_MODEL overrides the model name. ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=          # also set REASONING_LLM_MODEL: Google retires models on a schedule, so there is no default
# NVIDIA_API_KEY=         # key from build.nvidia.com; also set REASONING_LLM_MODEL (the hosted catalog retires models, so there is no default)
# NVIDIA_BASE_URL=        # only for a self-hosted NIM, for example http://localhost:8000/v1 (no key needed)
# OLLAMA_HOST=http://localhost:11434
# REASONING_LLM_MODEL=
# At start-up the API asks the provider one tiny question to confirm the key and model work.
# Set to false to skip it.
# WISDUM_AI_CHECK=true
# Characters of source text sent per draft (default 60000, between 2000 and 400000).
# WISDUM_SOURCE_BUDGET_CHARS=

# --- Embeddings (OpenAI if OPENAI_API_KEY is set, else a local model runs
# in-process via @xenova/transformers, so uploads still get embedded on a
# fully self-hosted deployment with no vendor key). ---
EMBEDDING_ENABLED=true
# EMBEDDING_MODEL=text-embedding-3-small
# LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# --- Automation / scheduler (Product Bible §17) ---
# Disabled by default: an unattended, repeating LLM call per tenant costs
# real money. Set to true to enable the automatic reasoning pass.
SCHEDULER_ENABLED=false
# Milliseconds between automatic reasoning passes, run once per tenant.
# Default: 3 hours (10800000ms).
REASONING_SCHEDULE_INTERVAL_MS=10800000

# --- GitHub input connector (Product Bible §6) ---
# Inert unless all three of GITHUB_TOKEN, GITHUB_REPOSITORIES, and
# GITHUB_SYNC_TENANT_ID are set. One global, operator-supplied credential
# (like the AI provider keys above) — GitHub content isn't inherently
# tenant-scoped, so v1 syncs into one designated tenant. SENSITIVE: never
# commit a real token.
# GITHUB_TOKEN=
# Comma-separated owner/repo list, e.g. wisdum-ai/wisdum-os,octocat/Hello-World
# GITHUB_REPOSITORIES=
# Which tenant captured Knowledge assets belong to.
# GITHUB_SYNC_TENANT_ID=
# Milliseconds between syncs. Default: 24 hours (86400000ms) — READMEs
# change rarely, and this keeps GitHub API usage trivial.
GITHUB_SYNC_INTERVAL_MS=86400000

# --- Publishing. "Publish" always creates a shareable page on this Wisdum site
# (PUBLIC_BASE_URL is the web app's public address). The destinations below are
# used only when configured; for LinkedIn, X and newsletters, copy the text. ---
PUBLIC_BASE_URL=http://localhost:3000
# DEVTO_API_KEY=
# GHOST_ADMIN_API_URL=
# GHOST_API_KEY=            # Ghost Admin API key, format id:secret
# SUBSTACK_WEBHOOK_URL=
