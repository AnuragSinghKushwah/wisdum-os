# Wisdum environment configuration
# Copy to .env.local and fill in values. Never commit real credentials.
#
# The platform is pre-alpha: these variables document the intended
# configuration surface and will become effective as services land.

# --- Application ---
WISDUM_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Web app (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Auth (required; signs bearer session tokens) ---
JWT_SECRET=

# --- PostgreSQL (primary datastore) ---
DATABASE_URL=postgresql+asyncpg://wisdum:wisdum@localhost:5432/wisdum

# --- Redis (cache & task queues) ---
REDIS_URL=redis://localhost:6379/0

# --- Meilisearch (full-text search) ---
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# --- S3-compatible object storage (media & files) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=wisdum
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI providers (Anthropic is used if set, else OpenAI; neither required) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
