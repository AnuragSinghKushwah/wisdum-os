{
  "name": "wisdum-os",
  "version": "0.0.0",
  "private": true,
  "description": "Wisdum — open-source, AI-native Knowledge Operations Platform (monorepo root)",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "platform/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^4.1.10"
  }
}
