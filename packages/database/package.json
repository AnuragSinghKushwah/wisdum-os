{
  "name": "@wisdum/database",
  "version": "0.0.0",
  "private": true,
  "description": "Persistence contracts and schema/migration/seed structure for PostgreSQL",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "wisdum-migrate": "./dist/migrate.js"
  },
  "scripts": {
    "build": "tsc -b",
    "migrate": "node dist/migrate.js up",
    "migrate:down": "node dist/migrate.js down"
  },
  "dependencies": {
    "@types/pg": "^8.20.0",
    "@wisdum/logger": "*",
    "@wisdum/types": "*",
    "pg": "^8.22.0"
  }
}
